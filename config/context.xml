<?xml version="1.0" encoding="UTF-8"?>
<!-- Tomcat context. Copied to META-INF/context.xml in the WAR.
     Start Tomcat with: -Dkanakani.db.url=jdbc:postgresql://localhost:5432/kanakani
                        -Dkanakani.db.user=kanakani -Dkanakani.db.password=...
     Never commit a real password. -->
<Context>
  <Resource name="jdbc/kanakani"
            auth="Container"
            type="javax.sql.DataSource"
            driverClassName="org.postgresql.Driver"
            url="${kanakani.db.url}"
            username="${kanakani.db.user}"
            password="${kanakani.db.password}"
            maxTotal="20"
            maxIdle="5"
            maxWaitMillis="5000"
            validationQuery="SELECT 1"
            testOnBorrow="true"/>
</Context>
