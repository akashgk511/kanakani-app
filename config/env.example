# Copy to env.local, fill in, and load it before starting Tomcat. Never commit env.local.
# Make each secret with:  openssl rand -base64 32

# Turns phone numbers into one-way tokens. If this leaks, numbers can be guessed. If it is lost, nobody can sign in again.
KANAKANI_PHONE_KEY=

# Protects the one-time codes.
KANAKANI_OTP_KEY=

# Seals post text. Format "keyId:base64,keyId:base64". The highest id seals new posts, older ids still open old posts.
# Example: KANAKANI_POST_KEYS=1:<output of openssl rand -base64 32>
KANAKANI_POST_KEYS=

# Development only: prints the sign-in code to the server log instead of sending a text.
# Leave unset in production and plug in a real SmsGateway.
KANAKANI_SMS=console

# Database (passed to Tomcat with -D, see config/context.xml)
# JAVA_OPTS="-Dkanakani.db.url=jdbc:postgresql://localhost:5432/kanakani -Dkanakani.db.user=kanakani -Dkanakani.db.password=change-me"
